POSTGRES_DB=paper_online
POSTGRES_USER=paper
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433
PORT=8000
PAPER_DOMAIN=paper.example.com
OPENALEX_API_KEY=
# pdf2zh 翻译走 OpenAI 兼容网关（config.yaml 里 pdf_translation.service 设为
# openai:<模型名>）时必填；base_url / model 写在 config.yaml，只有 key 放这里
PDF_TRANSLATION_OPENAI_API_KEY=
OUTBOUND_PROXY_URL=
OUTBOUND_NO_PROXY=localhost,127.0.0.1,::1,postgres,typesense,app,caddy,sub2api,pdf2zh
DOCKERHUB_PREFIX=docker.1ms.run/library/
POSTGRES_IMAGE=docker.1ms.run/library/postgres:16-alpine
CADDY_IMAGE=docker.1ms.run/library/caddy:2-alpine
PYPI_FILES_MIRROR=https://mirrors.aliyun.com/pypi/packages
# pdf2zh 镜像的构建源（app 用的 PYPI_FILES_MIRROR 是"文件下载"基址，pip -i 要的是
# simple 索引，语义不同所以单独一个变量）。留空则走 deb.debian.org / pypi.org，
# 国内会慢到把部署拖超时。
DEBIAN_MIRROR=https://mirrors.aliyun.com
PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
HF_ENDPOINT=https://hf-mirror.com
