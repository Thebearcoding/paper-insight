server:
  # Use 127.0.0.1 for local native development.
  # Use 0.0.0.0 when this config is mounted into the Docker app container.
  host: 127.0.0.1
  port: 8000

database:
  # Local native PostgreSQL example:
  url: postgresql:///paper_online
  # Docker Compose app container example:
  # url: postgresql://paper:change-me@postgres:5432/paper_online

typesense:
  # Docker Compose overrides enabled/host/api_key with environment variables.
  enabled: false
  protocol: http
  host: 127.0.0.1
  port: 8108
  api_key:
  collection_alias: papers
  # Built-in multilingual model for Chinese queries over English papers.
  embedding_model: ts/multilingual-e5-small
  semantic_search_enabled: true
  # 0 = keyword only, 1 = vector only.
  vector_alpha: 0.4
  vector_k: 500
  vector_distance_threshold: 0.45
  timeout_seconds: 10

docker:
  postgres_port: 5432
  typesense_port: 8108

admin:
  email: admin@example.com
  initial_password: change-this-admin-password

llm:
  openai_api_key:
  siliconflow_api_key:
  open_router_api_key:
  step_api_key:
  arkplan_api_key:
  deepseek_api_key:

paths:
  paper_content_cache_dir: data/paper_cache
  zotero_content_cache_dir: data/zotero_cache

zotero:
  # Required before a user can connect Zotero. Generate with:
  # openssl rand -hex 32
  credential_encryption_key:
  api_base_url: https://api.zotero.org
  request_timeout_seconds: 30
  max_attachment_mb: 50

auth:
  require_email_verification: false
  session_cookie_name: paper_session
  session_ttl_days: 30
  cookie_secure: false
  cookie_samesite: lax
  password_min_length: 8
  # GitHub OAuth App settings. For local development, configure the OAuth
  # callback URL in GitHub as:
  # http://127.0.0.1:8000/auth/github/callback
  github_client_id:
  github_client_secret:
  github_callback_url: http://127.0.0.1:8000/auth/github/callback
  frontend_base_url: http://127.0.0.1:5173

presence:
  online_timeout_seconds: 30
  snapshot_interval_seconds: 60
  retention_days: 90

background_analysis:
  # Disabled by default to avoid calling LLM APIs immediately on startup.
  enabled: false
  check_interval_seconds: 86400

api_search:
  # Default quotas for the external paper search API (per-user overrides live in the database).
  default_rpm_limit: 20
  default_daily_limit: 1000

hf_daily:
  enabled: true
  api_url: https://huggingface.co/api/daily_papers
  fetch_time: "22:00"
  timezone: Asia/Shanghai
  top_n: 5

feishu_notifications:
  enabled: true
  push_time: "10:00"
  max_daily_push_count: 5

cors:
  allowed_origins:
    - http://127.0.0.1:5173
    - http://localhost:5173
