server:
  # Use 127.0.0.1 for local native development.
  # Use 0.0.0.0 when this config is mounted into the Docker app container.
  host: 127.0.0.1
  port: 8000

database:
  # Local native PostgreSQL example:
  url: postgresql:///paper_online
  # Docker Compose app container example:
  # url: postgresql://paper:change-me@postgres:5432/paper_online

typesense:
  # Docker Compose overrides enabled/host/api_key with environment variables.
  enabled: false
  protocol: http
  host: 127.0.0.1
  port: 8108
  api_key:
  collection_alias: papers
  # Built-in multilingual model for Chinese queries over English papers.
  embedding_model: ts/multilingual-e5-small
  semantic_search_enabled: true
  # 0 = keyword only, 1 = vector only.
  vector_alpha: 0.4
  vector_k: 500
  vector_distance_threshold: 0.45
  timeout_seconds: 10

openalex:
  # Optional. Keyless online search works with a smaller daily allowance.
  api_key:
  base_url: https://api.openalex.org
  timeout_seconds: 15
  cache_ttl_seconds: 1800

docker:
  postgres_port: 5432
  typesense_port: 8108

admin:
  email: admin@example.com
  initial_password: change-this-admin-password

llm:
  # Required before storing provider API keys in the database. Generate with:
  # openssl rand -hex 32
  credential_encryption_key:
  openai_api_key:
  siliconflow_api_key:
  open_router_api_key:
  step_api_key:
  arkplan_api_key:
  deepseek_api_key:

paths:
  paper_content_cache_dir: data/paper_cache
  zotero_content_cache_dir: data/zotero_cache

pdf_translation:
  # PDF 中文翻译（pdf2zh 独立容器，见 docker-compose.yml 的 pdf2zh 服务）。
  # 产物不落服务器磁盘：pdf2zh 把 mono（纯中文）/dual（中英对照）PDF 放在
  # 容器内 Redis 里（内存，LRU 淘汰，Celery 默认 24 小时后过期），用户点击
  # 下载时由 app 流式转发，文件落在用户本机。
  enabled: false
  # pdf2zh HTTP 后端地址（compose 网络内）
  service_base_url: http://pdf2zh:11008
  # 翻译服务：openai:<模型名> 走 OpenAI 兼容网关（推荐，质量最好）；
  # bing 不需要 Key（免费服务会限流，适合先试跑）；google 在国内/数据
  # 中心 IP 上基本被限流（429），不建议。
  service: openai:deepseek-v4-flash
  lang_in: en
  lang_out: zh
  # service 为 openai:* 时生效。API Key 不要写在这里，放 .env 的
  # PDF_TRANSLATION_OPENAI_API_KEY（也可以用环境变量覆盖下面两项）。
  openai_base_url: https://agentrouter.org/v1
  openai_api_key:
  openai_model: deepseek-v4-flash
  # 同时最多进行几篇翻译（小服务器建议 1）
  max_concurrent_tasks: 1
  # 单篇翻译超时（秒）
  task_timeout_seconds: 1800

zotero:
  # Required before a user can connect Zotero. Generate with:
  # openssl rand -hex 32
  credential_encryption_key:
  api_base_url: https://api.zotero.org
  request_timeout_seconds: 30
  max_attachment_mb: 50

auth:
  require_email_verification: false
  session_cookie_name: paper_session
  session_ttl_days: 30
  cookie_secure: false
  cookie_samesite: lax
  password_min_length: 8
  # GitHub OAuth App settings. For local development, configure the OAuth
  # callback URL in GitHub as:
  # http://127.0.0.1:8000/auth/github/callback
  github_client_id:
  github_client_secret:
  github_callback_url: http://127.0.0.1:8000/auth/github/callback
  frontend_base_url: http://127.0.0.1:5173

presence:
  online_timeout_seconds: 30
  snapshot_interval_seconds: 60
  retention_days: 90

background_analysis:
  # Disabled by default to avoid calling LLM APIs immediately on startup.
  enabled: false
  check_interval_seconds: 86400

api_search:
  # Default quotas for the external paper search API (per-user overrides live in the database).
  default_rpm_limit: 20
  default_daily_limit: 1000

hf_daily:
  enabled: true
  api_url: https://huggingface.co/api/daily_papers
  # Optional HTTP proxy used only for HF Daily synchronization.
  proxy_url:
  fetch_time: "22:00"
  timezone: Asia/Shanghai
  top_n: 5

feishu_notifications:
  enabled: true
  push_time: "10:00"
  max_daily_push_count: 5

cors:
  allowed_origins:
    - http://127.0.0.1:5173
    - http://localhost:5173
