server:
  host: 0.0.0.0
  port: 8000

database:
  url: postgresql://paper:replace-with-the-same-postgres-password@postgres:5432/paper_online

openalex:
  # Optional free key for a larger daily online-search allowance.
  api_key:
  base_url: https://api.openalex.org
  timeout_seconds: 15
  cache_ttl_seconds: 1800

admin:
  email: replace-with-your-admin-email
  initial_password: replace-with-a-long-random-password

llm:
  credential_encryption_key: replace-with-output-of-openssl-rand-hex-32
  openai_api_key:
  siliconflow_api_key:
  open_router_api_key:
  step_api_key:
  arkplan_api_key:
  deepseek_api_key:

paths:
  paper_content_cache_dir: data/paper_cache
  zotero_content_cache_dir: data/zotero_cache

pdf_translation:
  # PDF 中文翻译（pdf2zh 独立容器，见 docker-compose.yml 的 pdf2zh 服务）。
  # 产物不落服务器磁盘：pdf2zh 把 mono（纯中文）/dual（中英对照）PDF 放在
  # 容器内 Redis 里（内存，LRU 淘汰，Celery 默认 24 小时后过期），用户点击
  # 下载时由 app 流式转发，文件落在用户本机。
  enabled: false
  service_base_url: http://pdf2zh:11008
  # openai:<模型名> 走 OpenAI 兼容网关（推荐，质量最好）；bing 不需要 Key
  # （免费服务会限流，适合先试跑）；google 在国内/数据中心 IP 上基本被
  # 限流（429），不建议。
  service: openai:deepseek-v4-flash
  lang_in: en
  lang_out: zh
  # service 为 openai:* 时生效。API Key 放 .env 的
  # PDF_TRANSLATION_OPENAI_API_KEY，不要写进这个文件。
  openai_base_url: https://agentrouter.org/v1
  openai_api_key:
  openai_model: deepseek-v4-flash
  max_concurrent_tasks: 1
  task_timeout_seconds: 1800

zotero:
  credential_encryption_key: replace-with-output-of-openssl-rand-hex-32
  api_base_url: https://api.zotero.org
  request_timeout_seconds: 30
  max_attachment_mb: 50

auth:
  require_email_verification: false
  session_cookie_name: paper_session
  session_ttl_days: 30
  cookie_secure: true
  cookie_samesite: lax
  password_min_length: 12
  github_client_id:
  github_client_secret:
  github_callback_url: https://replace-with-paper-domain/auth/github/callback
  frontend_base_url: https://replace-with-paper-domain

presence:
  online_timeout_seconds: 30
  snapshot_interval_seconds: 60
  retention_days: 90

background_analysis:
  enabled: false
  check_interval_seconds: 86400

hf_daily:
  enabled: true
  api_url: https://huggingface.co/api/daily_papers
  # Optional HTTP proxy used only for HF Daily synchronization.
  proxy_url:
  fetch_time: "22:00"
  timezone: Asia/Hong_Kong
  top_n: 5

feishu_notifications:
  enabled: false
  push_time: "10:00"
  max_daily_push_count: 5

cors:
  allowed_origins:
    - https://replace-with-paper-domain
